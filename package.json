{
  "name": "sift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "VITE_FEATURES=stats,economy,cosmetics,islandMove,friends,presence,together VITE_BACKEND=fake vite build --outDir dist-e2e --emptyOutDir && node e2e/smoke.mjs",
    "server:build": "node tools/server/build.mjs",
    "server:check": "node tools/server/build.mjs && node tools/server/bundle-check.mjs",
    "server:sql": "node tools/run.mjs tools/server/sql.ts",
    "content:new": "node tools/run.mjs tools/content-build/new.ts",
    "content:publish": "node tools/run.mjs tools/content-build/publish.ts",
    "content:build": "node tools/run.mjs tools/content-build/build.ts",
    "content:vox": "node tools/run.mjs tools/vox-import/main.ts",
    "content:validate": "node tools/run.mjs tools/content-build/validate.ts",
    "content:sprites": "node tools/sprite-gen/main.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:ios": "cap open ios",
    "mobile:android": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor-firebase/messaging": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/fiber": "^8.18.0",
    "dexie": "^4.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
